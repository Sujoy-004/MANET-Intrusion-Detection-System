# Generated simulation output — reproducible from a seed, never commit (guide §4)
traces/
data/
.manet-workspace/

# Experiment output: keep plots, drop bulk per-run records
results/*
!results/plots/

# Model binaries (champion model is tracked for instant out-of-the-box execution)
ml/models/*.joblib
!ml/models/best_model.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# GSD local planning & runtime state (commit_docs: false)
.opencode/
.gsd/

# MCP runtime artifacts & scratch logs
.playwright-mcp/

# Personal / uncommitted tools (Phase 6 personal artifacts)
.open-design/


# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Credentials and private keys
secrets/
credentials/
*.pem
*.key

# Gemini instructions
GEMINI.md
# OpenCode/we worktree runtime artifacts (worker records, logs)
.claude/
