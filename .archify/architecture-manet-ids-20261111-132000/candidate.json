  "cards": [
    {
      "dot": "cyan",
      "title": "Interactive TUI Architecture",
      "items": [
        "Built with Textual 8.2.8 with SOC cybersecurity dark theme and high-contrast accessibility",
        "Single-source keymap in manet/runtime/keymap.py preserves standard shortcut contracts",
        "WorkloadSupervisor drives non-blocking execution in a daemon thread with threading.Event cancellation",
        "Simulation workflow wizard provides 3-step preset discovery, parameter blur-validation, and IDS gating",
        "ResultsScreen displays split-pane academic QoS scorecards, isolation audit logs, and manifest checksums"
      ]
    },
    {
      "dot": "emerald",
      "title": "Discrete-Event Network Simulation",
      "items": [
        "Pure-Python discrete-event engine powered by SimPy 4.1.2 without external C/C++ compilation",
        "RFC 3561 AODV routing protocol with RREQ broadcast, RREP path setup, and RERR invalidation",
        "Continuous 2D Random Waypoint mobility model with configurable speed bounds and pause times",
        "RadioChannel dynamically computes link connectivity and neighbor sets based on Euclidean transmission range",
        "SimulationRunner steps execution in 200-event discrete slices for responsive UI telemetry"
      ]
    },
    {
      "dot": "rose",
      "title": "Attack Vectors & Threat Models",
      "items": [
        "BlackholeStrategy intercepts RREQ and fabricates RREP with max sequence 65535, dropping 100% data",
        "GrayholeStrategy selectively drops packets based on deterministic drop probability or periodic cycles",
        "Modular architecture decouples attack behavior from legitimate AODV routing logic via strategy hooks",
        "Deterministic scenario seeding ensures 100% reproducible malicious trace generation"
      ]
    },
    {
      "dot": "amber",
      "title": "Closed-Loop ML Intrusion Detection",
      "items": [
        "OnlineIDS extracts 9 non-leaking behavioral features across sliding time windows during active simulation",
        "Champion scikit-learn classifier (RandomForest/DecisionTree) evaluated under strict FPR <= 1.0% constraint",
        "Real-time node classification triggers dynamic blacklisting and immediate route table purging",
        "Active RERR broadcast invalidates routes through attacker, restoring Packet Delivery Ratio to ~92.9%"
      ]
    },
    {
      "dot": "violet",
      "title": "Data Integrity & Reproducibility",
      "items": [
        "Strict scenario-based GroupShuffleSplit prevents row-level data leakage between train and test sets",
        "Atomic experiment workspace allocation (.manet-workspace) with SHA-256 artifact verification",
        "AST import boundaries prevent UI package (manet/) from importing core simulation logic directly",
        "External composition root (bootstrap.py) injects execution dependencies preserving strict decoupling"
      ]
    }
  ]
}